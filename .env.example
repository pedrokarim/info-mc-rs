# ── Docker Compose ──
API_PORT=3001
WEB_PORT=3000

# ── API (Rust) ──

# Admin — Ascencia ID
ASCENCIA_ISSUER=https://id.ascencia.re
ASCENCIA_CLIENT_ID=asc_cid_...
ASCENCIA_CLIENT_SECRET=asc_cs_...
ASCENCIA_REDIRECT_URI=http://localhost:3000/admin/login
ASCENCIA_ALLOWED_ORIGIN=http://localhost:3000
# Générer avec `openssl rand -base64 32`. Chiffre les jetons stockés en base.
ASCENCIA_SESSION_SECRET=
# `true` en production HTTPS, `false` uniquement en développement local.
ASCENCIA_COOKIE_SECURE=false

# Likes — sel pour hasher les IPs (optionnel, auto-généré si absent)
IP_HASH_SALT=

# ── Web (SvelteKit) ──

# URL publique de l'API vue par le browser (vide = relative, proxied via /api)
# En dev local sans Docker : http://127.0.0.1:3001
# En Docker : laisser vide (le proxy SvelteKit s'en occupe)
PUBLIC_API_BASE=

# URL interne de l'API pour le SSR (server-side uniquement)
# En dev local : pas besoin (fallback sur localhost:3001)
# En Docker : http://api:3001
API_BASE_INTERNAL=

# Configuration publique du widget Ascencia ID
PUBLIC_ASCENCIA_ISSUER=https://id.ascencia.re
PUBLIC_ASCENCIA_CLIENT_ID=asc_cid_...
PUBLIC_ASCENCIA_REDIRECT_URI=http://localhost:3000/admin/login

# Origine publique servie par SvelteKit.
WEB_ORIGIN=http://localhost:3000

# ── Mesure d'audience (Sarutobi) ──

# Clé publique du site, obtenue sur https://sarutobi.ascencia.re → page
# Installation. C'est le nom que cet écran donne à copier : `siteId`.
# Vide = aucune collecte, aucune requête. Public par nature : elle transite en
# clair dans le JavaScript, et ce qui protège les chiffres est la liste des
# domaines autorisés déclarée côté Sarutobi.
PUBLIC_SARUTOBI_SITE_ID=

# Ancien nom de la même valeur, encore lu pour ne pas couper la mesure d'un
# déploiement pas encore migré. Ne rien y mettre dans une nouvelle installation.
# PUBLIC_SARUTOBI_PROJECT_TOKEN=

# Distingue les environnements dans le dashboard. Défaut : production.
PUBLIC_SARUTOBI_ENVIRONMENT=
